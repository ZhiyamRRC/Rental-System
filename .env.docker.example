# Copy to .env.docker and adjust, then:
#   docker compose --env-file .env.docker up -d --build

# ---- MySQL container ----
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=app_db

# ---- app ----
APP_PORT=3000
DB_CONNECTION_LIMIT=10
# Set to "webpack" only if the build machine is memory constrained.
NEXT_BUILD_BUNDLER=
# Set to "true" to bypass next/image optimisation.
NEXT_IMAGES_UNOPTIMIZED=false

# ---- first admin account (used once, when admin_users is empty) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Administrator

# ---- optional: WhatsApp booking notifications (Meta Cloud API) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_TO=
WHATSAPP_TEMPLATE_NAME=new_booking_admin
WHATSAPP_TEMPLATE_CONFIRMED=booking_confirmed_customer
WHATSAPP_TEMPLATE_DECLINED=booking_declined_customer
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=v23.0
