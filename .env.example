# ─── Database (MySQL / MariaDB) ───────────────────────────────────────────────
# Preferred: one MySQL URL. URL-encode special characters in user/password.
# MYSQL_URL wins over DATABASE_URL, so it is safe on hosts that inject their own
# DATABASE_URL value.
MYSQL_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

# Alternative: omit MYSQL_URL and set these individually.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="app_db"
DB_USER="app_user"
DB_PASSWORD="change-me"
DB_SSL="false"
DB_CONNECTION_LIMIT="10"

# Also accepted when it points at MySQL, e.g. mysql://user:pass@host:3306/db
# DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

# ─── Initial admin account (only used when admin_users is empty) ──────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Administrator"

# ─── Automatic booking → admin WhatsApp (Meta Cloud API) ────────────────────
# The Meta sender's Phone Number ID (NOT the visible phone number).
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# Permanent System User token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN="replace-with-permanent-system-user-token"
# Owner/admin recipient in E.164 digits. If omitted, Site Settings → WhatsApp is used.
WHATSAPP_ADMIN_TO="94771234567"
# Approved template for the ADMIN alert (7 parameters — see DEPLOYMENT.md).
WHATSAPP_TEMPLATE_NAME="new_booking_admin"
# Approved templates for the CUSTOMER messages sent on confirm / decline.
WHATSAPP_TEMPLATE_CONFIRMED="booking_confirmed_customer"
WHATSAPP_TEMPLATE_DECLINED="booking_declined_customer"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
WHATSAPP_GRAPH_VERSION="v23.0"
# Testing only; leave unset in production (defaults to https://graph.facebook.com).
# WHATSAPP_API_BASE_URL="http://127.0.0.1:4555"
